{
  "author": "Adrien Lacourpaille",
  "devDependencies": {
    "@adrienlcp/biome-config": "^0.3.0",
    "@adrienlcp/tsconfig": "^0.1.1",
    "@biomejs/biome": "2.6.4",
    "@cspell/dict-fr-fr": "^2.3.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "cspell": "^10.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "license": "AGPL-3.0-or-later",
  "name": "on-record",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "deps:upgrade": "corepack use pnpm@latest && pnpm -r up -L && biome migrate --write",
    "dev": "pnpm --filter @on-record/web dev",
    "ingest": "pnpm --filter @on-record/ingest start",
    "lighthouse": "pnpm --filter @on-record/web lighthouse",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "spell": "cspell --no-progress --gitignore \"**\"",
    "test": "pnpm -r test",
    "test:coverage": "vitest run --coverage",
    "validate": "pnpm lint:ci && pnpm spell && pnpm build && pnpm test"
  },
  "type": "module",
  "version": "0.1.0"
}
