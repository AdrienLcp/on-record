{
  "author": "Adrien Lacourpaille",
  "devDependencies": {
    "@adrienlcp/biome-config": "^0.1.0",
    "@adrienlcp/tsconfig": "^0.1.0",
    "@biomejs/biome": "2.5.14",
    "@cspell/dict-fr-fr": "^2.3.2",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "cspell": "^10.3.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "license": "AGPL-3.0-or-later",
  "name": "on-record",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "deps:upgrade": "corepack use pnpm@latest && pnpm -r up -L && biome migrate --write",
    "dev": "pnpm --filter @on-record/web dev",
    "ingest": "pnpm --filter @on-record/ingest start",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "spell": "cspell --no-progress --gitignore \"**\"",
    "test": "pnpm -r test",
    "test:coverage": "vitest run --coverage",
    "validate": "pnpm lint:ci && pnpm spell && pnpm build && pnpm test"
  },
  "type": "module",
  "version": "0.1.0"
}
